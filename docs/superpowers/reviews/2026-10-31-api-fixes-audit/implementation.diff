--- /dev/null
+++ b/tests/helpers/rewriteOutput.ts
@@ -0,0 +1,15 @@
+import type { ObjectRewriteOutputResult } from '../../src';
+
+/** Existing value-oriented assertions explicitly choose the lossy projection. */
+export function outputValue<Out>(result: {
+  getOutputResult(): ObjectRewriteOutputResult<Out>;
+}): Out | null {
+  const output = result.getOutputResult();
+  return output.kind === 'present' ? output.value : null;
+}
+export function capturedOutputValue<Out>(result: {
+  outputResultAtReturn: ObjectRewriteOutputResult<Out>;
+}): Out | null {
+  const output = result.outputResultAtReturn;
+  return output.kind === 'present' ? output.value : null;
+}
diff --git a/tests/omission-identity-validation.test.ts b/tests/omission-identity-validation.test.ts
new file mode 100644
index 0000000..05560b0
--- /dev/null
+++ b/tests/omission-identity-validation.test.ts
@@ -0,0 +1,135 @@
+import {
+  DagTraversal,
+  AsyncDagTraversal,
+  DepthFirstTreeTraversal,
+  AsyncDepthFirstTreeTraversal,
+  type DagVertexResolution,
+  type VertexTypes,
+} from '../src';
+
+type T = VertexTypes<string, string>;
+for (const Builder of [DagTraversal, AsyncDagTraversal]) {
+  test.each([
+    { kind: 'omitted', satisfiesDependencies: true },
+    {
+      kind: 'omitted',
+      identity: null,
+      vertexId: undefined,
+      satisfiesDependencies: true,
+    },
+    { kind: 'omitted', identity: undefined, satisfiesDependencies: true },
+    { kind: 'omitted', identity: 1, satisfiesDependencies: true },
+    { kind: 'omitted', identity: [], satisfiesDependencies: true },
+    { kind: 'omitted', identity: {}, satisfiesDependencies: true },
+    {
+      kind: 'omitted',
+      identity: Object.create({ vertexId: 'inherited' }),
+      satisfiesDependencies: true,
+    },
+  ])(
+    `${Builder.name} rejects malformed or retired omission identity %#`,
+    async (bad) => {
+      const runner = new Builder<T>({
+        traversableGraph: {
+          resolveRoot: () => bad as unknown as DagVertexResolution<T>,
+          resolveChild: () => ({
+            kind: 'omitted',
+            identity: null,
+            satisfiesDependencies: true,
+          }),
+        },
+      }).createRunner();
+      await expect(
+        Promise.resolve().then(async () => {
+          await runner.run();
+        }),
+      ).rejects.toBeInstanceOf(TypeError);
+    },
+  );
+
+  test.each([undefined, null, Symbol('identity failure')])(
+    `${Builder.name} preserves an omission identity getter failure %#`,
+    async (failure) => {
+      const runner = new Builder<T>({
+        traversableGraph: {
+          resolveRoot: () => ({
+            kind: 'omitted',
+            get identity(): never {
+              throw failure;
+            },
+            satisfiesDependencies: true,
+          }),
+          resolveChild: () => ({
+            kind: 'omitted',
+            identity: null,
+            satisfiesDependencies: true,
+          }),
+        },
+      }).createRunner();
+      await expect(
+        Promise.resolve().then(async () => {
+          await runner.run();
+        }),
+      ).rejects.toBe(failure);
+    },
+  );
+}
+for (const Builder of [DepthFirstTreeTraversal, AsyncDepthFirstTreeTraversal]) {
+  test(`${Builder.name} rejects graph identity before reading its value`, async () => {
+    let reads = 0;
+    const bad = {
+      kind: 'omitted' as const,
+      get identity() {
+        reads++;
+        return null;
+      },
+    };
+    const runner = new Builder<T>({
+      traversableTree: {
+        resolveRoot: () => bad as never,
+        resolveChild: () => ({ kind: 'omitted' }),
+      },
+    }).createRunner();
+    await expect(
+      Promise.resolve().then(async () => {
+        await runner.run();
+      }),
+    ).rejects.toBeInstanceOf(TypeError);
+    expect(reads).toBe(0);
+  });
+}
+
+for (const Builder of [DagTraversal, AsyncDagTraversal]) {
+  test.each([false, true])(
+    `${Builder.name} reads structural omission identity getters once (identified=%s)`,
+    async (identified) => {
+      let reads = 0;
+      class Omission {
+        get kind() {
+          return 'omitted' as const;
+        }
+        get identity() {
+          reads++;
+          return identified ? { vertexId: undefined } : null;
+        }
+        get satisfiesDependencies() {
+          return true as const;
+        }
+      }
+      const runner = new Builder<T>({
+        traversableGraph: {
+          resolveRoot: () => new Omission(),
+          resolveChild: () => ({
+            kind: 'omitted',
+            identity: null,
+            satisfiesDependencies: true,
+          }),
+        },
+        ...(identified ? { completedWork: new Set([undefined]) } : {}),
+      }).createRunner();
+      await runner.run();
+      expect(reads).toBe(1);
+      expect(runner.summary().unusedCompletedWorkIds).toEqual([]);
+    },
+  );
+}
diff --git a/tests/vertex-hint-ownership.test.ts b/tests/vertex-hint-ownership.test.ts
new file mode 100644
index 0000000..32f29a1
--- /dev/null
+++ b/tests/vertex-hint-ownership.test.ts
@@ -0,0 +1,39 @@
+import { Vertex, type VertexTypes, type VertexView } from '../src';
+
+type Types = VertexTypes<{ value: number }, { id: number }>;
+
+test('editing a structural observation clone cannot mutate a standalone input', () => {
+  const data = { value: 1 };
+  const hint = { id: 1 };
+  const original = new Vertex<Types>({ $data: data, $childHints: [hint] });
+  const observation: VertexView<Types> = original;
+  const clone = observation.clone();
+  clone.getChildHints().push({ id: 2 });
+  expect(original.getChildHints()).toEqual([{ id: 1 }]);
+  expect(clone.getData()).toBe(data);
+  expect(clone.getChildHints()[0]).toBe(hint);
+});
+
+test('constructor owns its editable hints without copying caller payload objects', () => {
+  const data = { value: 1 };
+  const hint = { id: 1 };
+  const hints = [hint];
+  const vertex = new Vertex<Types>({ $data: data, $childHints: hints });
+  hints.push({ id: 2 });
+  expect(vertex.getChildHints()).toEqual([{ id: 1 }]);
+  vertex.getChildHints().push({ id: 3 });
+  expect(hints).toEqual([{ id: 1 }, { id: 2 }]);
+  expect(vertex.getData()).toBe(data);
+  expect(vertex.getChildHints()[0]).toBe(hint);
+});
+
+test('clone overrides and Vertex overrides own their hint arrays', () => {
+  const base = new Vertex<Types>({ $data: { value: 1 }, $childHints: [] });
+  const hints = [{ id: 1 }];
+  const patched = base.clone({ $childHints: hints });
+  patched.getChildHints().push({ id: 2 });
+  expect(hints).toEqual([{ id: 1 }]);
+  const fromVertex = base.clone(patched);
+  fromVertex.getChildHints().push({ id: 3 });
+  expect(patched.getChildHints()).toEqual([{ id: 1 }, { id: 2 }]);
+});
