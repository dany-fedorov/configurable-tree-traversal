{
  "name": "configurable-tree-traversal",
  "version": "0.7.0",
  "description": "Very configurable tree traversal for TypeScript",
  "main": "./dist/index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples --ext .ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p ./tsconfig.build.json && tsconfig-replace-paths --project tsconfig.paths.json -s ./src",
    "prepack": "npm run build",
    "verify-package": "npm run build && node scripts/verify-package.cjs",
    "verify-examples": "node scripts/verify-examples.cjs",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run verify-examples && npm run verify-package",
    "prepare-me": "npm run build",
    "prepublish-me": "npm run check",
    "publish-me": "npm run check && npm publish --access public",
    "build-watch": "node scripts/watch.cjs",
    "tsfile": "ts-node -r tsconfig-paths/register",
    "benchmark": "npm run build && node scripts/benchmark.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dany-fedorov/configurable-tree-traversal.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tree traversal",
    "object traversal",
    "traversal",
    "tree",
    "graph"
  ],
  "author": "Dany Fedorov",
  "license": "MIT",
  "devDependencies": {
    "@jest/types": "^28.1.3",
    "@tsconfig/node16-strictest": "^1.0.3",
    "@types/jest": "^28.1.4",
    "@types/node": "^18.7.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "chokidar": "^3.5.3",
    "eslint": "8.18.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.26.0",
    "jest": "^28.1.2",
    "prettier": "2.7.1",
    "ts-jest": "^28.0.5",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.1.0",
    "tsconfig-replace-paths": "^0.0.11",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "Sorted_binary_tree_ALL_RGB.svg.png",
    "CHANGELOG.md",
    "docs/testing.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./traversals/depth-first-traversal": {
      "types": "./dist/traversals/depth-first-traversal/index.d.ts",
      "default": "./dist/traversals/depth-first-traversal/index.js"
    },
    "./traversals/breadth-first-traversal": {
      "types": "./dist/traversals/breadth-first-traversal/index.d.ts",
      "default": "./dist/traversals/breadth-first-traversal/index.js"
    },
    "./traversable-tree-implementations/traversable-object-tree": {
      "types": "./dist/traversable-tree-implementations/traversable-object-tree/index.d.ts",
      "default": "./dist/traversable-tree-implementations/traversable-object-tree/index.js"
    },
    "./tools/rewrite-object": {
      "types": "./dist/tools/rewrite-object/index.d.ts",
      "default": "./dist/tools/rewrite-object/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "traversals/depth-first-traversal": [
        "dist/traversals/depth-first-traversal/index.d.ts"
      ],
      "traversals/breadth-first-traversal": [
        "dist/traversals/breadth-first-traversal/index.d.ts"
      ],
      "traversable-tree-implementations/traversable-object-tree": [
        "dist/traversable-tree-implementations/traversable-object-tree/index.d.ts"
      ],
      "tools/rewrite-object": [
        "dist/tools/rewrite-object/index.d.ts"
      ],
      "*": [
        "dist/*"
      ],
      "dist/*": [
        "dist/*"
      ]
    }
  }
}
